{
    "version": 2,
    "builds": [
        {
            "src": "api/*.js",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "api/index.js",
            "headers": {
                "x-vercel-protection-bypass": "true"
            }
        }
    ]
}